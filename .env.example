# Supabase — copy these into your Vite env (never commit real values)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Demo placeholders + localStorage studio are DEV-ONLY conveniences.
# They activate only with `npm run dev`, or explicitly with:
# VITE_DEMO_MODE=true
# Production builds WITHOUT Supabase config show a configuration error
# instead of silently serving placeholder art. Never enable demo in prod.

# Optional: used only by the token-generation script via `supabase` CLI / service role locally.
# NEVER prefix a service-role key with VITE_ and NEVER ship it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_DB_URL=postgresql://...
